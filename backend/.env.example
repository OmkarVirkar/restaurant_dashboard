# Database client selection: pglite, postgres, sqlite, or mongodb
DB_CLIENT=pglite

# pgLite file-based mode
PG_LITE_PATH=./data/pglite.db

# PostgreSQL mode (used when DB_CLIENT=postgres)
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=postgres
# PG_DATABASE=restaurant_db
# PG_SSL=false

# SQLite mode
# SQLITE_PATH=./data/restaurant.sqlite

# MongoDB mode
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DATABASE=restaurant

# Authentication
# Use a high-entropy secret with at least 32 characters in production.
# JWT_SECRET=replace-with-a-secure-production-secret
# JWT_EXPIRES_IN_SECONDS=3600
# REFRESH_JWT_SECRET=replace-with-a-different-secure-refresh-secret
# REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800
